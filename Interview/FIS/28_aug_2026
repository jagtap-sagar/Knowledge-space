8. write C++ code for ([{}]) valid  ([{]}) in invalid, 
=>
/******************************************************************************
write C++ code for ([{}]) valid  ([{]}) in invalid, 

*******************************************************************************/

#include <iostream>
#include <stack>
using namespace std;

int main() {
   stack <char> st;
   char poped_data;
   bool isvalid = true;
   string given_str ="([)]";//"([{}])"; //"([{}])";
   
   for (auto ch : given_str) {
       if ( (ch =='(') || ( ch =='[' ) || ( ch =='{')  ){
           st.push(ch);
           //continue;
       } else if ( !st.empty() ){
            poped_data = st.top();
            st.pop();
            cout<<" poped_data"<<poped_data<<" ch:"<<ch;
            if ( (ch ==')' && poped_data =='(')  || 
                 (ch ==']' && poped_data =='[')  ||
                 (ch =='}' && poped_data =='{') )
                isvalid = true;
            else {
                isvalid = false; 
                break;
            }
       }else {
            cout<<" else false";
             isvalid = false; 
             break;
        }
    }//for 
            
   if ( ( ! st.empty() ) || (! isvalid) ) 
        std::cout << " after invalid" << std::endl;
    else 
        std::cout << "valid" << std::endl;        
}
