#include <iostream>
using namespace std;

int findMissing(int arr[], int size) {
    // n is the size of the array (which has one missing element from 1 to n+1)
    int expectedSum = ( (size + 1) * (size + 2) )/ 2;
    int actualSum = 0;
    
    for (int i = 0; i < size; i++) {
        actualSum += arr[i];
    }
    
    return expectedSum - actualSum;
}

int main() {
    int arr[] = {1, 3, 7, 5, 6, 2};
    int n = sizeof(arr) / sizeof(arr[0]);
    
    cout << "Missing element: " << findMissing(arr, n) << endl;
    
    return 0;
}
